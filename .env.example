# Stacked Budgeting - Environment Variables Template
# Copy this to .env or paste into Vercel Project Settings -> Environment Variables

# Firebase
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Gemini AI
VITE_STT_API_KEY=your_gemini_stt_api_key
VITE_ASSISTANT_API_KEY=your_gemini_api_key
VITE_MANAGER_API_KEY=your_gemini_api_key
VITE_RECEIPT_SCANNER_API_KEY=your_gemini_api_key
VITE_GEMINI_API_KEY=your_gemini_api_key
GEMINI_API_KEY=your_gemini_api_key

# ElevenLabs Voice
VITE_ELEVENLABS_API_KEY=your_elevenlabs_api_key
VITE_ELEVENLABS_AGENT_ID=your_elevenlabs_agent_id
ELEVENLABS_API_KEY=your_elevenlabs_api_key

# OpenAI & Anthropic (Optional)
VITE_OPENAI_API_KEY=your_openai_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# AWS Infrastructure
VITE_AWS_HTTP_ENDPOINT=https://your-api-id.execute-api.region.amazonaws.com
VITE_AWS_WS_ENDPOINT=wss://your-ws-id.execute-api.region.amazonaws.com/prod
